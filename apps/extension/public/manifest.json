{
  "manifest_version": 3,
  "name": "Oval — vérification en visio",
  "description": "Un widget flottant sur Meet, Zoom et Teams : vérifie qu'une présence humaine est bien là. Analyse dans le navigateur, aucune vidéo enregistrée.",
  "version": "0.3.0",
  "action": {
    "default_title": "Oval"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": [
        "widget.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://oval-moteur.onrender.com/*",
    "http://localhost:8787/*",
    "http://localhost:5173/*",
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*"
  ],
  "minimum_chrome_version": "116"
}
