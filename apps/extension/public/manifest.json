{
  "manifest_version": 3,
  "name": "Oval — panneau recruteur",
  "description": "Vérifie qu'une présence humaine est bien là en visio. Analyse dans le navigateur, aucune vidéo enregistrée.",
  "version": "0.1.0",
  "action": {
    "default_title": "Ouvrir le panneau Oval"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8787/*",
    "http://localhost:5173/*"
  ]
}
