{
  "manifest_version": 3,
  "name": "KYC Visio — panneau recruteur",
  "description": "Vérifie qu'un humain réel est présent en visio. Analyse dans le navigateur, aucune vidéo enregistrée.",
  "version": "0.1.0",
  "action": {
    "default_title": "Ouvrir le panneau KYC Visio"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "tabCapture", "activeTab", "storage"],
  "host_permissions": ["http://localhost:8787/*"]
}
