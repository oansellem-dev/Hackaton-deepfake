{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm -w apps/oval run build",
  "outputDirectory": "apps/oval/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://oval-moteur.onrender.com/api/$1"
    }
  ]
}
